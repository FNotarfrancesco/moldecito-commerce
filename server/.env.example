# Server Environment Variables
# Copia este archivo a server/.env y completa los valores

NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/moldecito

# JWT
JWT_SECRET=tu-super-secreto-cambia-en-produccion
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=moldecito_auth

# Cloudinary (crea cuenta gratis en cloudinary.com)
